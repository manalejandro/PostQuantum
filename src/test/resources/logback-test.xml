<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test logging configuration.

  The health indicator tests deliberately break the ML-KEM self-test to assert that the indicator
  reports DOWN, and Spring Boot's AbstractHealthIndicator logs those failures at WARN with the
  full stack trace. Raising the level for that one logger keeps the expected noise out of the
  build output without hiding anything else.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.manalejandro.postquantum.health.MlKemHealthIndicator" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
